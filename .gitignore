__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
.deepeval/
.deepeval_telemetry.txt

# Raw run artifacts are large and regenerable from config + dataset manifest + seed.
# Processed results and reports ARE committed (see docs/implementation-spec-v2.md s23).
results/raw/**/*.json
results/raw/**/*.jsonl
!results/raw/.gitkeep
results/traces/

# Never commit an API key. The key is read from the environment (spec section 6.3); these patterns
# exist so that a local convenience file can never be committed by accident.
.env
.env.*
*.key

# uv keeps the resolved environment in .venv; uv.lock IS committed so the environment is pinned.
